# ---- Backend (read by backend/app/config.py) ----

# Port the FastAPI dev server listens on (README commands assume 8000)
APP_PORT=8000

# Optional. Set to a real MongoDB connection string (e.g. mongodb://localhost:27017)
# to use a live MongoDB. Leave empty to use the built-in in-process store
# (mongomock + JSON snapshot), which is the default in this environment.
MONGODB_URI=

# Database name used when MONGODB_URI is set
MONGODB_DB=travel_planner

# Where the in-process store snapshots its data so it survives restarts.
# Relative paths are resolved from the repo root.
DATA_FILE=backend/data/store.json

# Comma-separated list of allowed CORS origins (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (read by Vite; must be prefixed VITE_) ----

# Base URL the React app uses to reach the API
VITE_API_BASE_URL=http://localhost:8000
